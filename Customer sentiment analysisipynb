    "## 8. Save Final Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Re-train best model on full training data and save\n",
    "best_model = LogisticRegression(max_iter=1000, C=1.0, random_state=42)\n",
    "best_model.fit(X_train_scaled, y_train)\n",
    "\n",
    "os.makedirs('models', exist_ok=True)\n",
    "joblib.dump(best_model,  'models/sentiment_model.joblib')\n",
    "joblib.dump(vectorizer,  'models/tfidf_vectorizer.joblib')\n",
    "joblib.dump(scaler,      'models/standard_scaler.joblib')\n",
    "\n",
    "print(\"Model artifacts saved to models/ ✅\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Inference Example"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_sentiment(text: str) -> str:\n",
    "    \"\"\"Predict sentiment for a single tweet.\"\"\"\n",
    "    cleaned = clean_text(text)\n",
    "    vec = vectorizer.transform([cleaned])\n",
    "    scaled = scaler.transform(vec)\n",
    "    return best_model.predict(scaled)[0]\n",
    "\n",
    "examples = [\n",
    "    \"I absolutely love this product! Amazing experience 🎉\",\n",
    "    \"Terrible service, would never buy again.\",\n",
    "    \"The package arrived today.\",\n",
    "]\n",
    "\n",
    "for tweet in examples:\n",
    "    print(f\"  Tweet    : {tweet}\")\n",
    "    print(f\"  Sentiment: {predict_sentiment(tweet)}\")\n",
    "    print()"
   ]
  }
